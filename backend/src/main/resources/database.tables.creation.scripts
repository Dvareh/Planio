BEGIN;

-- Users
CREATE TABLE users (
    id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    username VARCHAR(255) NOT NULL,
    email VARCHAR(255) NOT NULL UNIQUE,
    password VARCHAR(255) NOT NULL,
    role VARCHAR(255) NOT NULL,

    CONSTRAINT chk_user_role
        CHECK (role IN ('USER', 'ADMIN'))
);

-- Boards
CREATE TABLE boards (
    id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    name VARCHAR(255),
    description VARCHAR(255),
    owner_id BIGINT REFERENCES users(id),
    board_key VARCHAR(10) NOT NULL,
    next_task_number BIGINT NOT NULL
);

-- Board participants
CREATE TABLE board_users (
    board_id BIGINT NOT NULL REFERENCES boards(id),
    user_id BIGINT NOT NULL REFERENCES users(id)
);

-- Tasks
CREATE TABLE tasks (
    id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    title VARCHAR(255),
    description VARCHAR(255),
    due_date DATE,
    status VARCHAR(255),
    priority VARCHAR(255),
    board_id BIGINT REFERENCES boards(id),
    assigned_user_id BIGINT REFERENCES users(id),
    task_number BIGINT NOT NULL,
    reminder3_days_sent BOOLEAN NOT NULL DEFAULT FALSE,
    reminder1_day_sent BOOLEAN NOT NULL DEFAULT FALSE,

    CONSTRAINT chk_task_status
        CHECK (status IN ('TODO', 'IN_PROGRESS', 'DONE', 'CANCELLED')),

    CONSTRAINT chk_task_priority
        CHECK (priority IN ('LOW', 'MEDIUM', 'HIGH', 'URGENT'))
);

-- Board labels
CREATE TABLE labels (
    id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    name VARCHAR(50) NOT NULL,
    board_id BIGINT NOT NULL REFERENCES boards(id),

    CONSTRAINT uq_label_board_name UNIQUE (board_id, name)
);

-- Task labels
CREATE TABLE task_labels (
    task_id BIGINT NOT NULL REFERENCES tasks(id),
    label_id BIGINT NOT NULL REFERENCES labels(id),

    PRIMARY KEY (task_id, label_id)
);

-- Task comments
CREATE TABLE comments (
    id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    text VARCHAR(255),
    created_at TIMESTAMP(6) WITHOUT TIME ZONE,
    task_id BIGINT REFERENCES tasks(id),
    user_id BIGINT REFERENCES users(id)
);

-- Deadline notifications
CREATE TABLE notifications (
    id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    user_id BIGINT REFERENCES users(id),
    task_id BIGINT REFERENCES tasks(id),
    type VARCHAR(255),
    sent_at TIMESTAMP(6) WITHOUT TIME ZONE,
    read BOOLEAN NOT NULL
);

-- Task activity history
CREATE TABLE task_activities (
    id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    task_id BIGINT NOT NULL REFERENCES tasks(id),
    user_id BIGINT REFERENCES users(id),
    username VARCHAR(255) NOT NULL,
    type VARCHAR(255) NOT NULL,
    old_value TEXT,
    new_value TEXT,
    created_at TIMESTAMP(6) WITHOUT TIME ZONE NOT NULL,

    CONSTRAINT chk_activity_type CHECK (
        type IN (
            'TASK_CREATED',
            'STATUS_CHANGED',
            'PRIORITY_CHANGED',
            'DUE_DATE_CHANGED',
            'ASSIGNEE_CHANGED',
            'LABEL_ADDED',
            'LABEL_REMOVED',
            'COMMENT_ADDED',
            'COMMENT_UPDATED',
            'COMMENT_DELETED',
            'TITLE_CHANGED',
            'DESCRIPTION_CHANGED'
        )
    )
);

COMMIT;